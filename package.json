{
  "name": "petrolette",
  "description": "Fly-by-night news reading webapp.",
  "version": "1.0.10",
  "private": true,
  "license": "GPL-3.0-only",
  "engines": {
    "node": "8.5.0"
  },
  "repository": {
    "type": "git",
    "url": "https://framagit.org/yphil/petrolette"
  },
  "scripts": {
    "start": "pm2 start bin/www --watch --log-date-format='YYYY-MM-DD HH:mm Z' --name petrolette",
    "stop": "pm2 stop petrolette",
    "postinstall": "bower install"
  },
  "devDependencies": {
    "intro.js": "2.8.0-alpha.1",
    "mocha": "4.1.0",
    "should": "13.2.0"
  },
  "dependencies": {
    "bower": "1.8.2",
    "ejs": "2.5.7",
    "express": "4.16.2",
    "feedparser": "2.2.9",
    "feedrat": "latest",
    "favicon": "0.0.2",
    "pm2": "2.8.0"
  }
}
