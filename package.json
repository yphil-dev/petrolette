{
  "name": "petrolette",
  "description": "The news reader that doesn't know you",
  "version": "1.3.0b",
  "private": true,
  "license": "GPL-3.0-only",
  "config": {
    "unsafe-perm":true,
    "HTTP_PORT": 8000,
    "HTTPS_PORT": 8001,
    "FAVICONS_CACHE_DIR": "favicons-cache"
  },
  "engines": {
    "node": "14.15.3"
  },
  "repository": {
    "type": "git",
    "url": "https://framagit.org/yphil/petrolette"
  },
  "scripts": {
    "start": "pm2 start pm2.config.json ; pm2 update",
    "start-ssl": "pm2 start pm2.config.json --env ssl",
    "restart": "pm2 restart pm2.config.json",
    "stop": "pm2 stop petrolette",
    "errors": "pm2 logs --err --format",
    "test": "mocha --timeout 30s",
    "coverage": "nyc npm test",
    "preinstall": "mkdir -v favicons-cache",
    "postinstall": "bower install --allow-root && cd ./node_modules/favrat ; npm i --unsafe-perm && cd ../feedrat ; npm i --unsafe-perm"
  },
  "dependencies": {
    "body-parser": "^1.19.0",
    "bower": "^1.8.12",
    "compression": "^1.7.4",
    "ejs": "^3.1.5",
    "express": "^4.17.1",
    "favrat": "git+https://framagit.org/yphil/favrat.git@997da69c8198abbee63188231e3657c71064e8db",
    "feedparser": "^2.2.10",
    "feedrat": "git+https://framagit.org/yphil/feedrat.git@d0c54a0088a61a129823517a187ac670dfd3b1b1",
    "helmet": "^4.4.1",
    "iconv-lite": "^0.6.2",
    "idb": "^6.0.0",
    "morgan": "^1.10.0",
    "node-fetch": "^2.6.1",
    "npm": "^7.10.0",
    "pm2": "^4.5.6",
    "sanitize": "^2.1.0"
  },
  "devDependencies": {
    "mocha": "^8.3.2",
    "nyc": "^15.1.0",
    "should": "^13.2.3"
  }
}
