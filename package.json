{
  "name": "petrolette",
  "description": "Fly-by-night news reading webapp.",
  "version": "1.0.30",
  "private": true,
  "license": "GPL-3.0-only",
  "engines": {
    "node": "8.5.0"
  },
  "repository": {
    "type": "git",
    "url": "https://framagit.org/yphil/petrolette"
  },
  "scripts": {
    "petrolette": "pm2 start pm2.config.json",
    "petrolette-ssl": "pm2 start pm2.config.json --env ssl",
    "restart": "pm2 restart pm2.config.json",
    "stop": "pm2 stop petrolette",
    "show": "pm2 show petrolette",
    "log": "pm2 logs petrolette",
    "postinstall": "bower install"
  },
  "dependencies": {
    "body-parser": "1.18.3",
    "bower": "latest",
    "ejs": "2.6.1",
    "express": "4.16.4",
    "favrat": "latest",
    "feedparser": "2.2.9",
    "feedrat": "0.1.48",
    "iconv": "2.3.2",
    "npm": "6.5.0",
    "pm2": "3.2.8"
  }
}
