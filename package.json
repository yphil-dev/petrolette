{
  "name": "petrolette",
  "description": "Fly-by-night news reading webapp.",
  "version": "1.0.38",
  "private": true,
  "license": "GPL-3.0-only",
  "engines": {
    "node": "^14.15.3"
  },
  "repository": {
    "type": "git",
    "url": "https://framagit.org/yphil/petrolette"
  },
  "scripts": {
    "start": "pm2 start pm2.config.json",
    "start-ssl": "pm2 start pm2.config.json --env ssl",
    "restart": "pm2 restart pm2.config.json",
    "stop": "pm2 stop petrolette",
    "show": "pm2 show petrolette",
    "log": "pm2 logs petrolette",
    "postinstall": "bower install"
  },
  "dependencies": {
    "body-parser": "1.19.0",
    "bower": "latest",
    "ejs": "3.1.5",
    "express": "4.17.1",
    "favrat": "git+https://framagit.org/yphil/favrat.git",
    "feedparser": "2.2.10",
    "feedrat": "git+https://framagit.org/yphil/feedrat.git",
    "iconv-lite": "0.6.2",
    "npm": "^7.3.0",
    "request": "latest",
    "pm2": "4.5.1"
  }
}
