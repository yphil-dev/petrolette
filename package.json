{
  "name": "petrolette",
  "description": "Fly-by-night news reading webapp.",
  "version": "1.1.2",
  "private": true,
  "license": "GPL-3.0-only",
  "FAVICONS_CACHE_DIR": "favicons-cache",
  "engines": {
    "node": "*"
  },
  "repository": {
    "type": "git",
    "url": "https://framagit.org/yphil/petrolette"
  },
  "scripts": {
    "start": "./node_modules/pm2/bin/pm2 start pm2.config.json ; ./node_modules/pm2/bin/pm2 update",
    "start-ssl": "./node_modules/pm2/bin/pm2 start pm2.config.json --env ssl",
    "restart": "./node_modules/pm2/bin/pm2 restart pm2.config.json",
    "stop": "./node_modules/pm2/bin/pm2 stop petrolette",
    "show": "./node_modules/pm2/bin/pm2 show petrolette",
    "logs": "./node_modules/pm2/bin/pm2 logs petrolette",
    "errors": "./node_modules/pm2/bin/pm2 logs --err --format",
    "postinstall": "bower install --allow-root"
  },
  "dependencies": {
    "body-parser": "^1.19.0",
    "bower": "^1.8.12",
    "compression": "^1.7.4",
    "ejs": "^3.1.5",
    "express": "^4.17.1",
    "favrat": "git+https://framagit.org/yphil/favrat.git",
    "feedparser": "^2.2.10",
    "feedrat": "git+https://framagit.org/yphil/feedrat.git",
    "iconv": "^3.0.0",
    "morgan": "^1.10.0",
    "npm": "^7.5.2",
    "pm2": "^4.5.4",
    "request": "^2.88.2"
  }
}
