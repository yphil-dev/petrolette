{
  "apps" : [
    {
      "name"            : "petrolette",
      "script"          : "./bin/www",
      "watch"           : true,
      "ignore_watch"    : ["#*", "favicons-cache", ".git", "node_modules"],
      "log_date_format" : "YYYY-MM-DD HH:mm",
      "env" : {
        "PORT" : 8000,
        "NODE_ENV": "dev"
      },
      "env_ssl" : {
        "PORT" : 8080,
        "NODE_ENV": "ssl"
      }
    }
  ]
}
