{
  "apps" : [{
    "name"            : "ptl",
    "script"          : "./bin/www",
    "watch"           : true,
    "ignore_watch"    : ["#*", "favicons-cache", ".git", "node_modules"],
    "log_date_format" : "YYYY-MM-DD HH:mm",
    "env" : {
      "PORT" : 8080,
      "FAVICONS_CACHE_DIR": "favicons-cache"
    },
    "env_production" : {
      "NODE_ENV": "production"
    }
  }]
}
