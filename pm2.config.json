{
  "apps": [
    {
      "name": "petrolette",
      "script": "./http/server.js",
      "watch": true,
      "log_date_format": "HH:mm:ss",
      "ignore_watch": ["#*", "favicons-cache", ".git", "node_modules", "petrolette.feeds"],
      "time": true,
      "env": {
        "NODE_ENV": "development"
      },
      "env_production": {
        "NODE_ENV": "production"
      }
    }
  ]
}
