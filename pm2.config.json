{
  "apps" : [{
    "name"            : "petrolette",
    "script"          : "./bin/www",
    "watch"           : true,
    "ignore_watch"    : ["#*", "favicons-cache", ".git/"],
    "log_date_format" : "YYYY-MM-DD HH:mm",
    "env" : {
      "PORT" : 8666,
      "FAVICONS_CACHE_DIR": "favicons-cache"
    },
    "env_production" : {
      "NODE_ENV": "production"
    }
  }]
}
