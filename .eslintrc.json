{
  "globals": {
    "Dialog": false,
    "Feed": false,
    "Prefs": false,
    "Tab": false,
    "Utilities": false
  },
  "env": {
    "browser": true,
    "browser": true,
    "commonjs": true,
    "es6": true,
    "jquery": true
  },
  "extends": "eslint:recommended",
  "rules": {
    "one-var": ["error", "initializations"],
    "indent": [2, 2, {"MemberExpression": 1}],
    "linebreak-style": ["error", "unix"],
    "quotes": ["error", "single"],
    "semi": ["error", "never"]
  }
}
